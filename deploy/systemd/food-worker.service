[Unit]
Description=North University Food Automation Background Worker
After=network-online.target postgresql.service food-api.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=food
Group=food
WorkingDirectory=/opt/food/current
EnvironmentFile=/etc/food/app.env
ExecStart=/opt/food/node/current/bin/node apps/api/dist/worker.js
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

MemoryMax=512M
CPUQuota=100%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/food/shared

StandardOutput=journal
StandardError=journal
SyslogIdentifier=food-worker

[Install]
WantedBy=multi-user.target
