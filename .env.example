# ============================================================================
# .env.example — سامانه اتوماسیون تغذیه دانشگاه شمال
# ----------------------------------------------------------------------------
# هیچ مقدار واقعی را در این فایل یا در مخزن commit نکنید.
# در سرور: /opt/food/shared/.env با مجوز 600 و مالک کاربر سرویس.
# اپلیکیشن در startup با Zod اعتبارسنجی می‌شود؛ نبودِ کلید ضروری ⇒ اپ بالا نمی‌آید.
# ============================================================================

# --- اجرای عمومی ------------------------------------------------------------
# production | development | test
NODE_ENV=
# آدرس و پورت داخلی API (nginx به آن proxy می‌کند؛ از بیرون بسته باشد)
HOST=127.0.0.1
PORT=3001
# آدرس بیرونی سامانه (برای لینک‌های پیامک و redirect درگاه) — بدون / انتهایی
PUBLIC_BASE_URL=
# سطح لاگ: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# تعداد پرش‌های قابل‌اعتماد پروکسی برای خواندن IP از X-Forwarded-For (nginx = 1)
TRUSTED_PROXY_HOPS=1
# حداکثر اندازه بدنه درخواست (بایت) — برای آپلود اکسل ۶ مگابایت کافی است
BODY_LIMIT_BYTES=6291456

# --- پایگاه داده ------------------------------------------------------------
# نقش اجرایی (فقط DML). نمونه:
# postgres://food_app:PASSWORD@127.0.0.1:5432/food?sslmode=disable
DATABASE_URL=
# نقش مالک schema (فقط برای migration؛ در زمان اجرا استفاده نمی‌شود).
# اگر خالی باشد، migration با همان DATABASE_URL اجرا می‌شود.
DATABASE_MIGRATOR_URL=
# نام نقش‌هایی که migration باید بسازد و GRANT دهد (خالی ⇒ ساخت نقش انجام نمی‌شود)
DB_APP_ROLE=food_app
DB_MIGRATOR_ROLE=food_migrator
# رمز نقش‌ها فقط هنگام ساخت نقش توسط اسکریپت migration لازم است
DB_APP_ROLE_PASSWORD=
DB_MIGRATOR_ROLE_PASSWORD=
# حداکثر اندازه pool اتصال
DATABASE_POOL_MAX=10

# --- کلیدهای رمزنگاری (با scripts/gen-secrets.sh تولید کنید) ---------------
# امضای توکن CSRF (حداقل ۳۲ کاراکتر تصادفی)
CSRF_SECRET=
# pepper هش کد ملی (HMAC-SHA256). هشدار: تغییر آن همه ورودهای دانشجویی را
# نامعتبر می‌کند مگر با اسکریپت rehash (docs/OPERATIONS_RUNBOOK.md).
NATIONAL_ID_PEPPER=
# کلید رمزنگاری داده‌های حساس — اختیاری (در نسخهٔ اول برداشت بانکی/شبا حذف شده است؛ در صورت تنظیم باید ۶۴ کاراکتر hex باشد)
DATA_ENCRYPTION_KEY=
# کد یک‌بارمصرف راه‌اندازی برای ساخت اولین مدیر ارشد؛ پس از استفاده حذف/تغییر دهید
SETUP_CODE=

# --- نشست -------------------------------------------------------------------
# عمر نشست دانشجو/کارمند (ساعت) و کارکنان (ساعت) و سقف مطلق (ساعت)
SESSION_TTL_STUDENT_HOURS=12
SESSION_TTL_STAFF_HOURS=8
SESSION_ABSOLUTE_MAX_HOURS=168
# نام کوکی نشست. در production باید __Host-sid باشد (نیازمند Secure و Path=/)
SESSION_COOKIE_NAME=__Host-sid

# --- پرداخت (زرین‌پال) ------------------------------------------------------
# تا وقتی false است، شارژ فقط دستی توسط امور مالی انجام می‌شود
ONLINE_PAYMENT_ENABLED=false
ZARINPAL_MERCHANT_ID=
# sandbox فقط در NODE_ENV !== production و با این پرچم مجاز است
ALLOW_SANDBOX_GATEWAY=false

# --- پیامک ------------------------------------------------------------------
# console | kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# حداکثر تلاش ارسال برای هر پیام در صف
SMS_MAX_ATTEMPTS=3

# --- محدودیت نرخ ------------------------------------------------------------
# محدودیت هر IP روی مسیرهای ورود (تعداد درخواست در بازه)
RATE_LIMIT_LOGIN_ROUTE_MAX=20
# آستانهٔ شکست‌های یک IP (از همهٔ شناسه‌ها) برای تشدید به کپچا
RATE_LIMIT_LOGIN_MAX=200
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# محدودیت عملیات نوشتنی حساس (رزرو، لغو، شارژ، برداشت) در بازهٔ زیر
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=300
# محدودیت اسکن تحویل در سلف (دستگاه موبایل اپراتور)
RATE_LIMIT_SCAN_MAX=240
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# --- سرو کردن فایل‌های استاتیک فرانت‌اند و آپلودها توسط API ---
# در استقرار استاندارد Plesk، nginx به پورت داخلی API پروکسی می‌کند (SERVE_STATIC=true).
SERVE_STATIC=false
WEB_DIST_PATH=
# مسیر ذخیرهٔ تصاویر آپلودشدهٔ غذا (در سرور: /opt/food/shared/uploads با مالک food:food)
UPLOAD_DIR=.uploads
# سقف حجم تصویر غذا به بایت (پیش‌فرض ۲ مگابایت)
FOOD_IMAGE_MAX_BYTES=2097152
# غیرفعال‌سازی پردازش بومی sharp در صورت عدم پشتیبانی پردازنده از دستورات برداری (fallback امن حذف متادیتا)
SHARP_DISABLE=false

# --- توسعه / تست ------------------------------------------------------------
# اگر TEST_DATABASE_URL خالی باشد، تست‌های یکپارچه یک PostgreSQL داخلی
# (embedded-postgres) روی پورت TEST_PG_PORT راه‌اندازی می‌کنند.
TEST_DATABASE_URL=
TEST_PG_PORT=55432
# ساخت داده‌ی نمونه فقط در development و با پرچم صریح
ALLOW_DEMO_SEED=false
