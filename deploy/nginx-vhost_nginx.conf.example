# ============================================================================
# نمونهٔ پیکربندی Plesk nginx برای سامانه اتوماسیون تغذیه دانشگاه شمال
# مسیر قرارگیری روی سرور Plesk (هرگز فایل‌های تولیدی خود Plesk را ویرایش نکنید):
#   /var/www/vhosts/system/<domain>/conf/vhost_nginx.conf
#   (مثلاً برای دامنهٔ نمونه dining.example.edu یا food.example.org)
#
# پیش‌نیاز در پنل Plesk برای دامنهٔ موردنظر:
#   Hosting & DNS -> Apache & nginx Settings -> Proxy mode = OFF (غیرفعال کردن ارسال به Apache)
#   SSL/TLS Certificates -> فعال بودن گواهی معتبر و Redirect HTTP to HTTPS
#
# نحوهٔ اعمال امن (بدون دست زدن به سایر دامنه‌ها مانند shomaldoc یا nezarat):
#   1) sudo nginx -t
#   2) sudo cp deploy/nginx-vhost_nginx.conf.example /var/www/vhosts/system/<domain>/conf/vhost_nginx.conf
#   3) sudo plesk sbin httpdmng --reconfigure-domain <domain>
#   4) sudo nginx -t && sudo systemctl reload nginx
#
# نحوهٔ بازگشت سریع (Rollback) در صورت بروز هرگونه خطا:
#   1) sudo rm -f /var/www/vhosts/system/<domain>/conf/vhost_nginx.conf
#   2) sudo plesk sbin httpdmng --reconfigure-domain <domain>
#   3) sudo nginx -t && sudo systemctl reload nginx
# ============================================================================

# تطابق سقف بدنهٔ درخواست با BODY_LIMIT_BYTES=6291456 (آپلود اکسل ۵ مگابایت و تصویر غذا ۲ مگابایت)
client_max_body_size 6m;

# جلوگیری از کش شدن Service Worker و مانیفست PWA در مرورگرها
location = /sw.js {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
}

location = /manifest.webmanifest {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
}

# هدایت تمام مسیرهای API، تصاویر آپلودشده و SPA به سرویس داخلی Node (الگوی shomaldoc)
location / {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
}
